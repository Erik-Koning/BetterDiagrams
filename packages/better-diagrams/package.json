{
  "name": "@mosphere/better-diagrams",
  "version": "0.1.0",
  "description": "Embeddable React architecture and sequence diagram editors with an LLM-authorable JSON schema.",
  "keywords": [
    "diagram",
    "architecture",
    "sequence-diagram",
    "react-flow",
    "c4",
    "editor",
    "react",
    "llm",
    "mermaid",
    "plantuml"
  ],
  "license": "MIT",
  "author": "Erik Koning",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Erik-Koning/BetterDiagrams.git",
    "directory": "packages/better-diagrams"
  },
  "homepage": "https://github.com/Erik-Koning/BetterDiagrams#readme",
  "bugs": {
    "url": "https://github.com/Erik-Koning/BetterDiagrams/issues"
  },
  "type": "module",
  "main": "./dist/better-diagrams.cjs",
  "module": "./dist/better-diagrams.js",
  "types": "./dist/better-diagrams.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/better-diagrams.d.ts",
        "default": "./dist/better-diagrams.js"
      },
      "require": {
        "types": "./dist/better-diagrams.d.cts",
        "default": "./dist/better-diagrams.cjs"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      },
      "require": {
        "types": "./dist/contract.d.cts",
        "default": "./dist/contract.cjs"
      }
    },
    "./styles.css": "./dist/better-diagrams.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "contract": [
        "./dist/contract.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && npm run build:dts-cts",
    "build:dts-cts": "node -e \"for (const f of ['better-diagrams','contract']) require('fs').copyFileSync('dist/'+f+'.d.ts','dist/'+f+'.d.cts')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "postpack": "rm -f README.md LICENSE"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.2.0",
    "@xyflow/react": "^12.3.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.7"
  }
}
