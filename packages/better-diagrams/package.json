{
  "name": "@mosphere/better-diagrams",
  "version": "0.1.0",
  "description": "Embeddable React architecture and sequence diagram editors with an LLM-authorable JSON schema.",
  "keywords": [
    "diagram",
    "architecture",
    "sequence-diagram",
    "react-flow",
    "c4",
    "editor",
    "react",
    "llm",
    "mermaid",
    "plantuml"
  ],
  "license": "MIT",
  "author": "Erik Koning",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Erik-Koning/BetterDiagrams.git",
    "directory": "packages/better-diagrams"
  },
  "homepage": "https://github.com/Erik-Koning/BetterDiagrams#readme",
  "bugs": {
    "url": "https://github.com/Erik-Koning/BetterDiagrams/issues"
  },
  "type": "module",
  "main": "./dist/better-diagrams.cjs",
  "module": "./dist/better-diagrams.js",
  "types": "./dist/better-diagrams.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/better-diagrams.d.ts",
        "default": "./dist/better-diagrams.js"
      },
      "require": {
        "types": "./dist/better-diagrams.d.cts",
        "default": "./dist/better-diagrams.cjs"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      },
      "require": {
        "types": "./dist/contract.d.cts",
        "default": "./dist/contract.cjs"
      }
    },
    "./contract/folder/node": {
      "import": {
        "types": "./dist/contract-folder-node.d.ts",
        "default": "./dist/contract-folder-node.js"
      },
      "require": {
        "types": "./dist/contract-folder-node.d.cts",
        "default": "./dist/contract-folder-node.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./disk": {
      "import": {
        "types": "./dist/disk.d.ts",
        "default": "./dist/disk.js"
      },
      "require": {
        "types": "./dist/disk.d.cts",
        "default": "./dist/disk.cjs"
      }
    },
    "./styles.css": "./dist/better-diagrams.css",
    "./schema.json": "./dist/schema.json",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "contract": [
        "./dist/contract.d.ts"
      ],
      "contract/folder/node": [
        "./dist/contract-folder-node.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ],
      "disk": [
        "./dist/disk.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "app",
    "bin",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && npm run build:dts-cts && npm run build:schema",
    "build:dts-cts": "node -e \"for (const f of ['better-diagrams','contract','contract-folder-node','server','disk']) require('fs').copyFileSync('dist/'+f+'.d.ts','dist/'+f+'.d.cts')\"",
    "build:schema": "node scripts/write-json-schema.mjs",
    "build:explorer": "node scripts/build-explorer-runtime.mjs",
    "api:check": "node scripts/api-report.mjs --check",
    "api:update": "node scripts/api-report.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run api:check && node scripts/check-app.mjs",
    "prepack": "cp ../../README.md ../../LICENSE ../../CHANGELOG.md .",
    "postpack": "rm -f README.md LICENSE CHANGELOG.md"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.133.0",
    "openai": ">=7.34.0",
    "prettier": ">=2",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@xyflow/react": "^12.12.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@microsoft/api-extractor": "^7.59.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.18.0",
    "jsdom": "^30.1.2",
    "openai": "^7.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "bin": {
    "bd-folder": "./bin/bd-folder.mjs",
    "better-diagrams": "./bin/better-diagrams.mjs"
  }
}
