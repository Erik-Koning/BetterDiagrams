node_modules/
dist/
# The built editor `better-diagrams` serves (npm run build:app), shipped in the package.
packages/better-diagrams/app/

# Build artefacts and local scratch
*.tgz
.pkg-test/
# api-extractor's working copy of the reports (the reports themselves live in etc/)
packages/*/temp/

# Copied into the package by `prepack`, removed by `postpack`
packages/better-diagrams/README.md
packages/better-diagrams/LICENSE
packages/better-diagrams/CHANGELOG.md
# Copied in by the VS Code extension's `npm run package`, which also writes the .vsix
packages/vscode/LICENSE
*.vsix

# Folder-format trees the example app imports (drop an export in to try it)
templates/folders/*
!templates/folders/README.md
# A small, synthetic example of the folder format — tracked as documentation.
!templates/folders/datamodel/

# Playwright output
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Editor / tooling state
.claude/
.DS_Store
*.log

# Auto-save scratch: rewritten on every dev session. Curated templates go in templates/examples/.
templates/scratch/
# Folders linked from the example app's menu: paths on this machine only.
templates/linked.json
# Files linked from the example app's menu: symlinks to paths on this machine only.
templates/symlinks/
