!templates/folders/datamodel/

# Playwright output
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Editor / tooling state
.claude/
.DS_Store
*.log

# Auto-save scratch: rewritten on every dev session. Curated templates go in templates/examples/.
templates/scratch/
